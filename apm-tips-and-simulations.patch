@@ -0,0 +1,50 @@
+-- Tips and tricks for the apm_lib inserter functions, with simulations. The category and the
+-- title entry "apm-introduction" come from apm_lib (prototypes/tips.lua).
+-- `mods = { "apm_lib_ldinc" }` runs apm_lib's runtime script in the simulations, so they show
+-- the real behaviour instead of a copy of it.
+
+---@param file string
+---@return SimulationDefinition
+local function simulation(file)
+	return {
+		init_file = "__apm_power_ldinc__/simulations/" .. file,
+		mods = { "apm_lib_ldinc" },
+		init_update_count = 60,
+	}
+end
+
+data:extend({
+	{
+		type = "tips-and-tricks-item",
+		name = "apm-fuel-chaining",
+		category = "apm",
+		order = "b",
+		indent = 1,
+		tag = "[entity=apm_assembling_machine_0][item=coal]",
+		dependencies = { "apm-introduction" },
+		trigger = { type = "build-entity", entity = "apm_assembling_machine_0", count = 3 },
+		simulation = simulation("fuel-chaining.lua"),
+	},
+	{
+		type = "tips-and-tricks-item",
+		name = "apm-fuel-leech",
+		category = "apm",
+		order = "c",
+		indent = 1,
+		tag = "[entity=burner-inserter]",
+		dependencies = { "apm-introduction", "burner-inserter-refueling" },
+		trigger = { type = "build-entity", entity = "burner-inserter", count = 10 },
+		simulation = simulation("fuel-leech.lua"),
+	},
+	{
+		type = "tips-and-tricks-item",
+		name = "apm-ash-chaining",
+		category = "apm",
+		order = "d",
+		indent = 1,
+		tag = "[item=apm_generic_ash]",
+		dependencies = { "apm-fuel-chaining" },
+		trigger = { type = "build-entity", entity = "apm_assembling_machine_0", count = 6 },
+		simulation = simulation("ash-chaining.lua"),
+	},
+})
diff --git a/apm_power/simulations/ash-chaining.lua b/apm_power/simulations/ash-chaining.lua
new file mode 100644
index 0000000..cfccced
--- /dev/null
+++ b/apm_power/simulations/ash-chaining.lua
@@ -0,0 +1,83 @@
+-- Tips and tricks simulation: ash moves along a chain of burner machines. The first
+-- machine's ash goes into the second machine's burnt-result slot in one batch, and the
+-- inserter at the end of the chain puts it into the chest.
+-- Runs as a console command inside the simulation (no require). The behaviour comes from
+-- apm_lib's own runtime script, loaded through `mods = { "apm_lib_ldinc" }` in the tip.
+
+game.simulation.camera_position = { 0.5, 0.5 }
+
+local surface = game.surfaces[1]
+
+-- the inserter functions are a map setting; make sure they are on in the simulation
+pcall(function() settings.global["apm_lib_inserter_functions"] = { value = true } end)
+
+---@param x number
+---@param recipe string?
+---@return LuaEntity
+local function machine(x, recipe)
+	local m = surface.create_entity({ name = "apm_assembling_machine_0", position = { x, 0.5 }, force = "player" })
+	---@cast m -nil
+	if recipe then
+		m.set_recipe(recipe)
+		m.insert({ name = "iron-plate", count = 100 })
+	end
+	return m
+end
+
+--- Places a burner inserter at x that takes from `from` and puts into `to`. Tries every
+--- direction, so it does not depend on which way the direction points.
+---@param x number
+---@param from LuaEntity
+---@param to LuaEntity
+---@return LuaEntity?
+local function inserter(x, from, to)
+	for _, dir in pairs({ defines.direction.east, defines.direction.west, defines.direction.north, defines.direction.south }) do
+		local e = surface.create_entity({ name = "burner-inserter", position = { x, 0.5 }, direction = dir, force = "player" })
+		if e then
+			if e.pickup_target == from and e.drop_target == to then
+				return e
+			end
+			e.destroy()
+		end
+	end
+end
+
+local a, b = machine(-3.5, "iron-gear-wheel"), machine(0.5, "iron-gear-wheel")
+local chest = surface.create_entity({ name = "wooden-chest", position = { 3.5, 0.5 }, force = "player" })
+---@cast chest -nil
+
+-- enough fuel in both, so no fuel is chained and only the ash moves
+for _, e in pairs({ a, b }) do
+	e.get_fuel_inventory().insert({ name = "coal", count = 20 })
+end
+
+-- a batch of ash in the first machine (a batch is 10% of the ash stack)
+a.burner.burnt_result_inventory.insert({ name = "apm_generic_ash", count = 250 })
+
+inserter(-1.5, a, b)
+inserter(2.5, b, chest)
+
+remote.call("apm_inserter", "rescan")
+
+storage.apm = { a = a, b = b, chest = chest }
+
+-- every 40 s: a new batch of ash in the first machine, the chest is emptied
+script.on_nth_tick(60 * 40, function()
+	local s = storage.apm
+
+	if s.a.valid then
+		s.a.burner.burnt_result_inventory.insert({ name = "apm_generic_ash", count = 250 })
+	end
+
+	if s.chest.valid then
+		s.chest.clear_items_inside()
+	end
+
+	for _, e in pairs({ s.a, s.b }) do
+		if e.valid then
+			e.get_output_inventory().clear()
+			e.insert({ name = "iron-plate", count = 100 })
+			e.get_fuel_inventory().insert({ name = "coal", count = 5 })
+		end
+	end
+end)
diff --git a/apm_power/simulations/fuel-chaining.lua b/apm_power/simulations/fuel-chaining.lua
new file mode 100644
index 0000000..ac9e33d
--- /dev/null
+++ b/apm_power/simulations/fuel-chaining.lua
@@ -0,0 +1,74 @@
+-- Tips and tricks simulation: fuel chaining. The inserters pass fuel from one burner
+-- machine's fuel slot to the next; only the first machine gets coal.
+-- Runs as a console command inside the simulation (no require). The behaviour comes from
+-- apm_lib's own runtime script, loaded through `mods = { "apm_lib_ldinc" }` in the tip.
+
+game.simulation.camera_position = { 0.5, 0.5 }
+
+local surface = game.surfaces[1]
+
+-- the inserter functions are a map setting; make sure they are on in the simulation
+pcall(function() settings.global["apm_lib_inserter_functions"] = { value = true } end)
+
+---@param x number
+---@param recipe string?
+---@return LuaEntity
+local function machine(x, recipe)
+	local m = surface.create_entity({ name = "apm_assembling_machine_0", position = { x, 0.5 }, force = "player" })
+	---@cast m -nil
+	if recipe then
+		m.set_recipe(recipe)
+		m.insert({ name = "iron-plate", count = 100 })
+	end
+	return m
+end
+
+--- Places a burner inserter at x that takes from `from` and puts into `to`. Tries every
+--- direction, so it does not depend on which way the direction points.
+---@param x number
+---@param from LuaEntity
+---@param to LuaEntity
+---@return LuaEntity?
+local function inserter(x, from, to)
+	for _, dir in pairs({ defines.direction.east, defines.direction.west, defines.direction.north, defines.direction.south }) do
+		local e = surface.create_entity({ name = "burner-inserter", position = { x, 0.5 }, direction = dir, force = "player" })
+		if e then
+			if e.pickup_target == from and e.drop_target == to then
+				return e
+			end
+			e.destroy()
+		end
+	end
+end
+
+local a, b, c = machine(-3.5, "iron-gear-wheel"), machine(0.5, "iron-gear-wheel"), machine(4.5, "iron-gear-wheel")
+a.get_fuel_inventory().insert({ name = "coal", count = 20 })
+
+-- the inserters start without fuel: they take it from the machine they serve
+inserter(-1.5, a, b)
+inserter(2.5, b, c)
+
+-- script-built entities raise no build event: let apm_lib pick up the inserters
+remote.call("apm_inserter", "rescan")
+
+storage.apm_machines = { a, b, c }
+
+-- every 30 s: machines 2 and 3 run dry, machine 1 gets coal again
+script.on_nth_tick(60 * 30, function()
+	local m = storage.apm_machines
+
+	for i, e in pairs(m) do
+		if e.valid then
+			e.get_output_inventory().clear()
+			e.insert({ name = "iron-plate", count = 100 })
+			if i > 1 then
+				e.get_fuel_inventory().clear()
+				e.burner.remaining_burning_fuel = 0
+			end
+		end
+	end
+
+	if m[1].valid then
+		m[1].get_fuel_inventory().insert({ name = "coal", count = 20 })
+	end
+end)
diff --git a/apm_power/simulations/fuel-leech.lua b/apm_power/simulations/fuel-leech.lua
