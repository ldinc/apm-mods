@@ -0,0 +1,75 @@
+-- Tips and tricks simulation: a burner inserter that carries iron plates refuels itself
+-- from the fuel slot of the machine it feeds.
+-- Runs as a console command inside the simulation (no require). The behaviour comes from
+-- apm_lib's own runtime script, loaded through `mods = { "apm_lib_ldinc" }` in the tip.
+
+game.simulation.camera_position = { 0, 0.5 }
+
+local surface = game.surfaces[1]
+
+-- the inserter functions are a map setting; make sure they are on in the simulation
+pcall(function() settings.global["apm_lib_inserter_functions"] = { value = true } end)
+
+---@param x number
+---@param recipe string?
+---@return LuaEntity
+local function machine(x, recipe)
+	local m = surface.create_entity({ name = "apm_assembling_machine_0", position = { x, 0.5 }, force = "player" })
+	---@cast m -nil
+	if recipe then
+		m.set_recipe(recipe)
+		m.insert({ name = "iron-plate", count = 100 })
+	end
+	return m
+end
+
+--- Places a burner inserter at x that takes from `from` and puts into `to`. Tries every
+--- direction, so it does not depend on which way the direction points.
+---@param x number
+---@param from LuaEntity
+---@param to LuaEntity
+---@return LuaEntity?
+local function inserter(x, from, to)
+	for _, dir in pairs({ defines.direction.east, defines.direction.west, defines.direction.north, defines.direction.south }) do
+		local e = surface.create_entity({ name = "burner-inserter", position = { x, 0.5 }, direction = dir, force = "player" })
+		if e then
+			if e.pickup_target == from and e.drop_target == to then
+				return e
+			end
+			e.destroy()
+		end
+	end
+end
+
+local chest = surface.create_entity({ name = "wooden-chest", position = { -2.5, 0.5 }, force = "player" })
+---@cast chest -nil
+chest.insert({ name = "iron-plate", count = 200 })
+
+local m = machine(0.5, "iron-gear-wheel")
+m.get_fuel_inventory().insert({ name = "coal", count = 20 })
+
+-- the inserter has no fuel and only ever carries iron plates
+local ins = inserter(-1.5, chest, m)
+
+remote.call("apm_inserter", "rescan")
+
+storage.apm = { chest = chest, machine = m, inserter = ins }
+
+-- every 20 s: the inserter runs out of fuel again, the chest and the machine are refilled
+script.on_nth_tick(60 * 20, function()
+	local s = storage.apm
+
+	if s.inserter and s.inserter.valid then
+		s.inserter.get_fuel_inventory().clear()
+		s.inserter.burner.remaining_burning_fuel = 0
+	end
+
+	if s.chest.valid then
+		s.chest.insert({ name = "iron-plate", count = 50 })
+	end
+
+	if s.machine.valid then
+		s.machine.get_output_inventory().clear()
+		s.machine.get_fuel_inventory().insert({ name = "coal", count = 5 })
+	end
+end)
